# BilitFast — نمونه متغیرهای محیطی
#
# این فایل را به .env کپی کنید و مقادیر واقعی را پر کنید.
# .env در .gitignore است و هرگز نباید commit شود.
#
#   cp .env.example .env
#
# تولید کلید تصادفی:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------- عمومی ----------
NODE_ENV=production
PORT=3000

# اجبار ورود کاربران. روی سرور عمومی حتماً 1 بماند؛
# 0 یعنی هر بازدیدکننده‌ای بدون حساب به موتور جستجو/رزرو دسترسی دارد.
BILITFAST_MULTIUSER=1

# سخت‌گیری امنیتی: نبود کلید باعث بالا نیامدن سرویس می‌شود (fail-closed).
BILITFAST_ENFORCE_SECURITY=1

# ---------- کلیدهای رمزنگاری (الزامی در تولید) ----------
# هر کدام یک رشته تصادفی ۶۴ کاراکتری هگز. اگر عوض شوند، نشست‌های باز و
# اعتبارنامه‌های ذخیره‌شده باطل می‌شوند.

# امضای توکن نشست کاربران
BILITFAST_SESSION_KEY=

# امضای کد فعال‌سازی و توکن دوره آزمایشی
BILITFAST_LICENSE_KEY=

# رمزگذاری توکن وضعیت رزرو و اعتبارنامه صفیر ریل
BILITFAST_TOKEN_KEY=

# جایگزین سه مورد بالا: یک کلید اصلی که بقیه از آن مشتق می‌شوند
# BILITFAST_MASTER_KEY=

# ---------- ذخیره‌سازی ----------
# مسیر داده. در Docker روی volume تنظیم شود تا با هر deploy پاک نشود.
BILITFAST_DATA_DIR=/data

# ذخیره‌ساز مشترک (فقط اگر چند نمونه هم‌زمان اجرا می‌کنید)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- زمان‌بند ----------
# راز نقطه ورود /api/cron. بدون آن، زمان‌بند غیرفعال است (503).
BILITFAST_CRON_SECRET=

# ---------- CORS (فقط برای نسخه دسکتاپ روی دامنه دیگر) ----------
# فهرست مبدأهای مجاز با کاما. خالی = فقط same-origin (امن‌ترین حالت).
# هرگز * نگذارید؛ با کوکی و توکن ترکیب خطرناکی می‌سازد.
# BILITFAST_ALLOWED_ORIGINS=https://app.example.com

# ---------- پیام‌رسان‌ها (اختیاری) ----------
# TELEGRAM_BOT_TOKEN=
# BALE_BOT_TOKEN=
# BALE_API_BASE_URL=https://tapi.bale.ai
# EITAA_BOT_TOKEN=
# EITAA_API_BASE_URL=https://eitaayar.ir/api

# ---------- هرگز اینجا ننویسید ----------
# شناسه و گذرواژه صفیر ریل کاربران. آن‌ها از طریق رابط برنامه گرفته و
# رمزشده روی رکورد همان کاربر ذخیره می‌شوند، نه در متغیر محیطی.
