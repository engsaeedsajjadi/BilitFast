# BilitFast Web Self-Hosted — example only. Never deploy with blank keys.
# Recommended: generate .env ONCE with scripts/setup-selfhost.js.
NODE_ENV=production
PORT=3000
BILITFAST_DOMAIN=agency.example.com
BILITFAST_SELF_HOSTED=1
BILITFAST_DATA_DIR=/data
BILITFAST_MASTER_KEY=
BILITFAST_ADMIN_BOOTSTRAP_SECRET=
BILITFAST_MULTIUSER=1
BILITFAST_ENFORCE_SECURITY=1
BILITFAST_ENFORCE_LICENSE=1
# CORS same-origin by default. Never set wildcard origins.
BILITFAST_ALLOWED_ORIGINS=
# Seller's PUBLIC signing key is in config/license-public.pem.
# NEVER put the vendor's private key on any customer host.
