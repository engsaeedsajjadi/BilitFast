{
  "manifest_version": 3,
  "name": "BilitFast — اتصال سفیر ریل",
  "version": "3.5.0",
  "description": "تأیید انسانی در سایت رسمی با پنل BilitFast؛ فقط درج اطلاعات مسافر با اقدام کاربر، بدون ارسال خودکار فرم یا دخالت در ARCaptcha.",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://safirrail.ir/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "انتقال کوکی صفیر ریل به بیلیت فست",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://safirrail.ir/etrain/*"
      ],
      "js": [
        "checkout-flow.js",
        "safir-passenger-helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "workspace.html"
  }
}
