{
  "manifest_version": 3,
  "name": "BilitFast — اتصال سفیر ریل",
  "version": "3.13.3",
  "description": "انتقال مستقیم نشست با یک کلیک از تب رسمی SafirRail به تب باز BilitFast؛ بدون PIN یا سرور واسط.",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://safirrail.ir/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "اتصال مستقیم نشست از تب سفیر ریل به BilitFast",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://safirrail.ir/etrain/*"
      ],
      "js": [
        "checkout-flow.js",
        "selection-confirm.js",
        "auto-official-flow.js",
        "safir-passenger-helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "workspace.html"
  }
}
